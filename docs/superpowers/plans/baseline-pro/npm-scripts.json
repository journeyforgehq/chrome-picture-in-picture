{
  "build": "webpack --config webpack/webpack.prod.cjs",
  "build:dev": "webpack --config webpack/webpack.dev.cjs",
  "build:zip": "npm run build && node scripts/zip-dist.mjs",
  "watch": "webpack --watch --config webpack/webpack.dev.cjs",
  "start": "webpack --watch --config webpack/webpack.dev.cjs",
  "start:staging": "cross-env APP_ENV=staging webpack --watch --config webpack/webpack.dev.cjs",
  "start:prod": "cross-env APP_ENV=prod webpack --watch --config webpack/webpack.dev.cjs",
  "build:staging": "cross-env APP_ENV=staging webpack --config webpack/webpack.prod.cjs",
  "build:prod": "cross-env APP_ENV=prod webpack --config webpack/webpack.prod.cjs",
  "test": "vitest run",
  "test:watch": "vitest",
  "typecheck": "tsc --noEmit",
  "verify": "npm run typecheck && npm run test && npm run build",
  "preview:build": "webpack --config webpack/webpack.preview.cjs",
  "preview:serve": "npx http-server dist-preview -p 4173",
  "e2e": "playwright test",
  "e2e:staging": "cross-env TARGET=staging playwright test",
  "e2e:install": "playwright install chromium",
  "e2e:typecheck": "tsc --noEmit -p e2e/tsconfig.json",
  "e2e:live": "playwright test --config playwright.stripe-live.config.ts",
  "e2e:visual": "playwright test --config playwright.visual.config.ts",
  "e2e:fixtures": "playwright test --config playwright.fixtures.config.ts",
  "e2e:granted": "playwright test --config playwright.granted.config.ts"
}
