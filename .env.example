# Build-time config for the extension. webpack's DefinePlugin reads process.env
# at build time (see extension/src/billing/config.ts). The defaults below already
# match `npm run dev`, so you do NOT need to set any of these for local dev —
# this file documents what a scaffolded child overrides for a real deployment.
#
# Backend the extension calls (default: the local wrangler dev port).
BACKEND_BASE_URL=http://localhost:8787
# Stripe Checkout links for the paywall (real links only needed to test checkout).
STRIPE_ANNUAL_URL=
STRIPE_LIFETIME_URL=
# Welcome page opened on install (optional).
WELCOME_URL=
# Post-uninstall feedback page opened by Chrome on removal (optional).
# Best on the welcome-page domain, e.g. https://your-site.com/uninstall
UNINSTALL_URL=
# Per-app accent color for the antd theme. Quote it — dotenv treats an unquoted
# leading `#` as a comment, blanking the value and falling back to default blue.
ACCENT="#1677ff"
# Force the popup/options UI to Pro WITHOUT a worker (pure-frontend dev). Pinned
# false in webpack.prod. Prefer backend DEV_FORCE_PRO for full-stack dev.
DEV_PRO=false
