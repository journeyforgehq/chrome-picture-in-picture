# Committed, non-secret build config for PRODUCTION (APP_ENV=prod). Public client values only.
# BACKEND_BASE_URL = the deployed production worker URL (chrome-<ext>-backend-production.<subdomain>.workers.dev).
BACKEND_BASE_URL=REPLACE_WITH_PROD_BACKEND_URL
# Stripe LIVE-mode payment links for production:
STRIPE_MONTHLY_URL=
STRIPE_ANNUAL_URL=
STRIPE_LIFETIME_URL=

# Checkout mode. "session" (default) calls POST /checkout and the backend mints a
# Stripe Checkout Session, carrying metadata.app, a statement descriptor, a rate
# limit and a consent record. "link" falls back to the static STRIPE_*_URL Payment
# Links — a rebuild, no store resubmission.
#
# Set to "session" deliberately: every STRIPE_*_URL in this repo is EMPTY, so link
# mode would build a malformed "?client_reference_id=..." URL and open a blank tab.
# Session mode fails loudly with not_configured until Stripe Price IDs are set on
# the Worker. Fail loud beats fail silent on a money path.
CHECKOUT_MODE=link
