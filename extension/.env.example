# PUBLIC client build config — safe to commit (all of these are baked into the
# shipped extension bundle). Real SECRETS live server-side (backend/.dev.vars,
# `wrangler secret put`), never here.
#
# The scaffold writes a real .env from your `new-extension` flags. Fill any blanks
# before `npm run build`. Use .env.local (git-ignored) for machine-specific overrides.

BACKEND_BASE_URL=
STRIPE_MONTHLY_URL=
STRIPE_ANNUAL_URL=
STRIPE_LIFETIME_URL=
WELCOME_URL=
# Post-uninstall feedback page (Chrome opens it on removal). Best on the
# welcome-page domain, e.g. https://your-site.com/uninstall
UNINSTALL_URL=
# Quote the accent — dotenv treats an unquoted leading `#` as a comment, which
# would blank the value and fall back to the default blue.
ACCENT="#1677ff"

# --- Environment selection (Phase 3c) ---
# APP_ENV=local (default) loads THIS .env; APP_ENV=staging loads .env.staging;
# APP_ENV=prod loads .env.production. LOCAL needs no file (config.ts defaults to
# http://localhost:8787). Use `npm run build:staging` / `build:prod` / `start:staging`.
