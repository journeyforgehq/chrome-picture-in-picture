# Committed, non-secret build config for STAGING (APP_ENV=staging). Public client values only.
# BACKEND_BASE_URL = the deployed staging worker URL (chrome-<ext>-backend-staging.<subdomain>.workers.dev).
# STILL UNSET: no worker is deployed for this extension yet. Every other repo's
# staging backend answers on https://<worker>.tiny-pond-cbf7.workers.dev/health;
# nothing responds for picture-in-picture under any name. Deploy the backend and
# put its URL here. Until then a staging build bakes this literal in as the API
# base and every request fails.
BACKEND_BASE_URL=REPLACE_WITH_STAGING_BACKEND_URL
# Stripe TEST-mode payment links for staging:
STRIPE_MONTHLY_URL=
STRIPE_ANNUAL_URL=
STRIPE_LIFETIME_URL=https://buy.stripe.com/test_4gMbIVdRM4me4YR4sw3Ru01

# Checkout mode. "session" (default) calls POST /checkout and the backend mints a
# Stripe Checkout Session, carrying metadata.app, a statement descriptor, a rate
# limit and a consent record. "link" falls back to the static STRIPE_*_URL Payment
# Links — a rebuild, no store resubmission.
#
# Set to "link": the TEST-mode Payment Link above is live, so staging exercises a
# real Stripe checkout end to end. A test link cannot leak into a shipped bundle —
# isUsableCheckoutLink (src/billing/checkout.ts) refuses one in a PRODUCTION build.
CHECKOUT_MODE=link
